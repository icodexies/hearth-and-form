# Supabase — public project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Supabase — public anon key (never use the service-role key in a frontend)
VITE_SUPABASE_ANON_KEY=

# Private visitor analytics (server-only, set these in Vercel)
# BLOB_READ_WRITE_TOKEN is added automatically when a Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
ANALYTICS_ADMIN_KEY=
VISIT_HASH_SALT=
